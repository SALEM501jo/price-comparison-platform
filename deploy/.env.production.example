# Copy to deploy/.env.production and fill in. That file is gitignored.
#
#   cp deploy/.env.production.example deploy/.env.production
#
# The app REFUSES TO BOOT in production if several of these are still at their
# laptop defaults (app/config.py: production_problems). That is deliberate --
# every one of them fails silently otherwise, and a silent failure passes a
# health check.

# --- Where the site lives ---------------------------------------------------
# The bare domain Caddy will get a certificate for. DNS must already point at
# this server, or the ACME challenge fails and there is no HTTPS.
SITE_DOMAIN=ahsanse3r.com
# Let's Encrypt sends expiry warnings here. A real mailbox you read.
ACME_EMAIL=you@example.com

# --- Database ---------------------------------------------------------------
POSTGRES_USER=ahsan
# Generate, do not invent:  openssl rand -base64 32
POSTGRES_PASSWORD=
POSTGRES_DB=price_comparison
# The hostname is the compose service name. Must match the three values above.
DATABASE_URL=postgresql://ahsan:REPLACE_ME@postgres:5432/price_comparison

# --- Cache and queue --------------------------------------------------------
# NOT localhost. The app refuses a production boot on a localhost Redis,
# because the rate limiter fails OPEN when Redis is unreachable (brute-force
# protection silently off) while social sign-in fails CLOSED.
REDIS_URL=redis://redis:6379/0

# --- Secrets ----------------------------------------------------------------
# openssl rand -hex 32
JWT_SECRET_KEY=

# --- Environment ------------------------------------------------------------
ENVIRONMENT=production
# Both the API and the SPA are on this one origin now, so this is the site
# itself. Verification and password-reset links are built from it.
APP_BASE_URL=https://ahsanse3r.com
API_BASE_URL=https://ahsanse3r.com
ALLOWED_ORIGINS=https://ahsanse3r.com
TRUSTED_HOSTS=ahsanse3r.com,www.ahsanse3r.com

# ONE proxy in front: Caddy. Count from the RIGHT of X-Forwarded-For, because
# a client can forge everything to the left of what infrastructure wrote. Put a
# CDN in front of Caddy and this becomes 2.
TRUSTED_PROXY_COUNT=1

# --- Email ------------------------------------------------------------------
# "console" is refused in production: it logs messages and sends nothing, so
# verification links would never arrive and signup would silently never
# complete.
EMAIL_BACKEND=smtp
EMAIL_FROM=Ahsan Se3r <noreply@ahsanse3r.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
# Where contact-form messages are forwarded. Optional: without it messages are
# still stored and readable in the admin panel.
SUPPORT_EMAIL=

# --- Social sign-in (both optional) -----------------------------------------
# Leave a provider blank and its button simply does not render. /auth/providers
# advertises only what is credentialed, so the site ships fine on Google alone,
# or on neither.

# Google: free. Google Cloud console -> Credentials -> OAuth client ID (Web).
# Authorised redirect URI must be EXACTLY:
#   https://ahsanse3r.com/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple: requires a PAID Apple Developer Program membership (USD 99/year).
# You need a Services ID, a Team ID, a Key ID and the .p8 private key.
# Redirect URI must be EXACTLY:
#   https://ahsanse3r.com/auth/oauth/apple/callback
# Apple will not accept an http redirect URI, so this cannot be tested locally.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# The CONTENTS of the .p8 file, not a path to it. Newlines as \n on one line.
# *.p8 is gitignored; do not commit the file itself either.
APPLE_PRIVATE_KEY=
