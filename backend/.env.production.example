# Production configuration.
#
# Copy this, fill in every REQUIRED value, and set it as the environment of
# the deployed app. The app CHECKS these at startup and refuses to boot if a
# dangerous one is still on its development default -- see
# Settings.production_problems() in app/config.py. That refusal is deliberate:
# every setting here defaults to something correct for a laptop and wrong for
# the internet, and all of them used to fail silently.
#
# The failure each one causes, if you are wondering why it matters, is written
# above it.


# === REQUIRED: the app will not start without these ========================

ENVIRONMENT=production

# Postgres. Neon, Supabase, or any managed instance.
# USE THE POOLED CONNECTION STRING if your provider offers one -- each worker
# opens its own pool (5 + 10 overflow), and a free tier's connection cap is
# lower than you would guess.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Generate with: openssl rand -hex 32
# The placeholder from .env.example is REJECTED at startup: anyone with the
# repository could otherwise mint an admin token.
JWT_SECRET_KEY=

# Redis. Upstash's free tier is enough. Without it the rate limiter fails
# OPEN (allows) and the search cache is skipped -- the app still works.
REDIS_URL=rediss://default:password@host:6379

# The hostnames this API answers to. NEVER '*' in production: any Host header
# would be accepted, which is cache poisoning and password-reset phishing.
TRUSTED_HOSTS=api.yourdomain.com,yourdomain.com

# Where the FRONTEND is served from. This is what CORS allows.
# Still pointing at localhost means the deployed frontend is blocked entirely.
ALLOWED_ORIGINS=https://yourdomain.com

# Where links inside emails point -- the FRONTEND's address, not the API's.
# Left on localhost, every verification and reset link is unusable, nobody can
# confirm an account, and the only symptom is signups that never complete.
# Deliberately never derived from the request Host header: that is
# client-supplied, and a link built from one is a phishing link sent under
# your own name.
APP_BASE_URL=https://yourdomain.com


# === REQUIRED: mail =========================================================
#
# 'console' is REFUSED in production. The app used to boot on it, report
# healthy, and silently drop every verification and reset link.
# Any provider with a free tier works; they all speak SMTP.

EMAIL_BACKEND=smtp
EMAIL_FROM=Ahsan Se3r <noreply@yourdomain.com>
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USERNAME=resend
SMTP_PASSWORD=
SMTP_USE_TLS=true

# Set EMAIL_BACKEND=null instead if you accept that NO mail is sent. That is
# allowed -- choosing to send nothing is a decision, drifting into it is not.


# === STRONGLY RECOMMENDED ===================================================

# How many reverse proxies sit in front of the app.
#
# THE HIGHEST-RISK SETTING HERE. X-Forwarded-For is client-supplied and each
# proxy APPENDS to it, so only the last N entries are trustworthy. Get it
# wrong and one of two things happens:
#
#   too low  -- every visitor is read as coming from the proxy, they all share
#               ONE rate-limit bucket, and the 101st request in any minute
#               returns 429 to everybody. Looks exactly like an outage.
#   too high -- a caller can forge their own address and escape the limit.
#
# Fly.io behind its own edge: 1. Cloudflare in front of Fly: 2.
# Directly exposed with nothing in front: 0.
#
# The app logs an error at runtime if it sees X-Forwarded-For while this is 0,
# so a wrong value announces itself rather than waiting to be discovered.
TRUSTED_PROXY_COUNT=1

# Where contact-form messages are forwarded. Optional: messages are STORED
# and readable in /admin either way, so an unset value loses the notification,
# not the message.
SUPPORT_EMAIL=you@yourdomain.com


# === ONLY IF THE API AND FRONTEND ARE ON DIFFERENT SITES ====================
#
# Leave this alone if you serve both from one domain (api.yourdomain.com and
# yourdomain.com count as the same site -- SameSite ignores subdomains and
# ports). Across genuinely different registrable domains the refresh cookie
# becomes third-party, and Safari blocks those by default: sessions would die
# on every page refresh for iPhone users. Prefer one domain.
# COOKIE_SAMESITE=none


# === NOT AN ENVIRONMENT VARIABLE, BUT REQUIRED ==============================
#
# A WORKER PROCESS. Queued scrapes are claimed by:
#
#     python -m app.services.worker --loop
#
# or by the GitHub Actions cron in .github/workflows/scrape.yml calling it.
# Without one, /admin/scrape enqueues rows that nothing ever runs, and the
# admin screen shows jobs sitting in 'queued' for ever.
#
# And run the migrations before first boot:
#
#     alembic upgrade head
