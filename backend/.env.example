# Database (Supabase or local PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/price_comparison

# JWT — generate with: openssl rand -hex 32  (minimum 32 characters)
JWT_SECRET_KEY=change_this_to_a_random_32_char_hex_string

# Redis (Upstash or local)
REDIS_URL=redis://localhost:6379/0

# App
ENVIRONMENT=development
# Accepts JSON (["a","b"]) or comma-separated (a,b)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
TRUSTED_HOSTS=*

# Number of reverse proxies in front of the app. 0 ignores X-Forwarded-For
# entirely. Set it to the real count in production: the header is
# client-supplied, and trusting it with no proxy present lets any caller forge
# a fresh rate-limit bucket per request.
TRUSTED_PROXY_COUNT=0

# --- Email -------------------------------------------------------------------
# "console" prints messages to the server log and sends nothing. Verification
# works fully in development this way — no provider account, no domain, no DNS.
# The app refuses to start with console in production rather than silently
# pretending to send.
EMAIL_BACKEND=console

# Where links in emails point. This is the FRONTEND's address, not the API's.
# Never derived from the request Host header: that is client-supplied, and a
# link built from one is a phishing link sent under your own name.
APP_BASE_URL=http://localhost:5173

# Set EMAIL_BACKEND=smtp and fill these to send for real. Any provider with a
# free tier works — Resend, Brevo, SES — they all speak SMTP.
# EMAIL_FROM=Ahsan Se3r <noreply@yourdomain.com>
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USERNAME=resend
# SMTP_PASSWORD=your_api_key
# SMTP_USE_TLS=true

# --- Social sign-in ----------------------------------------------------------
# Both providers are OPTIONAL and independent. A provider is enabled only when
# all of its values are present; GET /auth/providers reports which, and the
# frontend renders a button only for those. Leave a block empty and that
# button simply does not appear.
#
# A HALF-FILLED BLOCK IS REFUSED AT STARTUP in production. A client id with an
# empty secret would otherwise boot healthy, render the button, and fail one
# provider round trip later at the token exchange.

# Where the provider sends the browser back — this API's own address, NOT the
# frontend's. It is registered with the provider as the redirect URI and must
# match byte for byte, so it is configured rather than guessed from the
# request Host header (which is client-supplied, and therefore forgeable).
# The callbacks are API_BASE_URL + /auth/oauth/google/callback and
# API_BASE_URL + /auth/oauth/apple/callback.
API_BASE_URL=http://localhost:8000

# Google Cloud Console → Credentials → OAuth client ID → Web application.
# Free. Add the callback above to "Authorised redirect URIs".
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Sign in with Apple. Needs a PAID Apple Developer account, which is why the
# site is built to work with Google alone. APPLE_CLIENT_ID is the SERVICES ID
# (com.example.web), not the app id. There is no static secret: the app signs
# an ES256 JWT with the .p8 key on every exchange, so paste the key itself.
# Newlines may be written as \n on one line.
# APPLE_CLIENT_ID=
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY=
