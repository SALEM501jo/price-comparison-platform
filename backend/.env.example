# Database (Supabase or local PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/price_comparison

# JWT — generate with: openssl rand -hex 32  (minimum 32 characters)
JWT_SECRET_KEY=change_this_to_a_random_32_char_hex_string

# Redis (Upstash or local)
REDIS_URL=redis://localhost:6379/0

# App
ENVIRONMENT=development
# Accepts JSON (["a","b"]) or comma-separated (a,b)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
TRUSTED_HOSTS=*

# Number of reverse proxies in front of the app. 0 ignores X-Forwarded-For
# entirely. Set it to the real count in production: the header is
# client-supplied, and trusting it with no proxy present lets any caller forge
# a fresh rate-limit bucket per request.
TRUSTED_PROXY_COUNT=0

# --- Email -------------------------------------------------------------------
# "console" prints messages to the server log and sends nothing. Verification
# works fully in development this way — no provider account, no domain, no DNS.
# The app refuses to start with console in production rather than silently
# pretending to send.
EMAIL_BACKEND=console

# Where links in emails point. This is the FRONTEND's address, not the API's.
# Never derived from the request Host header: that is client-supplied, and a
# link built from one is a phishing link sent under your own name.
APP_BASE_URL=http://localhost:5173

# Set EMAIL_BACKEND=smtp and fill these to send for real. Any provider with a
# free tier works — Resend, Brevo, SES — they all speak SMTP.
# EMAIL_FROM=PriceCompare <noreply@yourdomain.com>
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USERNAME=resend
# SMTP_PASSWORD=your_api_key
# SMTP_USE_TLS=true
